# Kernel config fragment: BBB + SSD1315 OLED + MPU6050 IMU + GPIO buttons
# Merged on top of omap2plus_defconfig by scripts/build-kernel.sh.
# Kconfig does not support trailing comments: keep comments on their own line.

# I2C core, AM335x adapter, /dev/i2c-X for i2cdetect
CONFIG_I2C=y
CONFIG_I2C_OMAP=y
CONFIG_I2C_CHARDEV=y

# Loadable modules (ssd1315_oled.ko, inv_mpu6050_i2c.ko)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# MPU6050 through IIO (INV_MPU6050_IIO is selected by the I2C glue)
CONFIG_IIO=y
CONFIG_INV_MPU6050_I2C=m

# GPIO buttons as evdev: gpio-keys built in, no module to load
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y

# Root filesystem on SD card partition 2, devtmpfs mounted by the kernel
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Release string is exactly the tag: the board DTS copied into the kernel
# tree must not turn it into "<tag>-dirty"
# CONFIG_LOCALVERSION_AUTO is not set
