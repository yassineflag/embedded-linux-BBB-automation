# Kernel config fragment — BBB SSD1315 OLED + MPU6050 IMU + GPIO buttons
# Applied on top of omap2plus_defconfig via merge_config.sh

# --- I2C Core ---
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y          # /dev/i2c-X userspace access
CONFIG_I2C_OMAP=y             # AM335x I2C adapter

# --- Module support ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# --- MPU6050 IMU via IIO subsystem ---
# The in-tree driver handles all register access; exposes data via /sys/bus/iio
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_INV_MPU6050=m          # MPU6050 core (built as module)
CONFIG_INV_MPU6050_I2C=m      # I2C transport for MPU6050

# --- GPIO buttons (gpio-keys driver) ---
# Maps GPIO pins to standard Linux input key events
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y          # /dev/input/eventX userspace interface
CONFIG_KEYBOARD_GPIO=y        # gpio-keys driver (built-in)

# --- Framebuffer (optional) ---
CONFIG_FB=y
