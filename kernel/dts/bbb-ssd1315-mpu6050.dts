/dts-v1/;
/plugin/;

/*
 * Device Tree Overlay — SSD1315 OLED + MPU6050 IMU + 4 GPIO buttons
 * BeagleBone Black
 *
 * I2C2 devices (P9.19=SCL, P9.20=SDA):
 *   0x3C — SSD1315 OLED display
 *   0x68 — MPU6050 IMU (AD0 pin = GND)
 *
 * GPIO buttons (P8 header, active-low with internal pull-up):
 *   BTN_1 — P8.7  (GPIO2_2  = gpio 66)
 *   BTN_2 — P8.8  (GPIO2_3  = gpio 67)
 *   BTN_3 — P8.9  (GPIO2_5  = gpio 69)  [note: numbering skips 68]
 *   BTN_4 — P8.10 (GPIO2_4  = gpio 68)
 *
 * Wiring:
 *   Each button: one pin → P8.XX, other pin → GND (P8.1 or P8.2)
 *   Pull-up is enabled in the DTS, so unpressed = HIGH, pressed = LOW.
 */

&i2c2 {
    status = "okay";
    clock-frequency = <400000>;    /* 400 kHz Fast-mode */

    /* ---------------------------------------------------------------
     * SSD1315 OLED display
     * Driver: ssd1315_oled.ko (out-of-tree)
     * Device node: /dev/ssd1315
     * --------------------------------------------------------------- */
    ssd1315: oled@3c {
        compatible = "ssd1315-oled", "solomon,ssd1315";
        reg = <0x3c>;
        label = "ssd1315-oled";
    };

    /* ---------------------------------------------------------------
     * MPU6050 6-DOF IMU (3-axis accel + 3-axis gyro)
     * Driver: inv_mpu6050_i2c (in-tree, IIO subsystem)
     * Data: /sys/bus/iio/devices/iio:device0/in_accel_x_raw etc.
     * --------------------------------------------------------------- */
    mpu6050: imu@68 {
        compatible = "invensense,mpu6050";
        reg = <0x68>;
        /*
         * interrupt-parent and interrupts can be added here if the
         * INT pin of MPU6050 is wired to a BBB GPIO (optional).
         * Without it the driver falls back to polling mode.
         */
    };
};

/* ---------------------------------------------------------------
 * 4 GPIO push-buttons via gpio-keys driver
 * Exposed as /dev/input/eventX — read with standard Linux input API
 * Key codes: BTN_0..BTN_3 (evdev codes 256..259)
 * --------------------------------------------------------------- */
/ {
    gpio_buttons: gpio-buttons {
        compatible = "gpio-keys";
        #address-cells = <1>;
        #size-cells = <0>;
        label = "BBB GPIO Buttons";

        button@0 {
            label = "BTN_1";
            linux,code = <256>;        /* BTN_0 */
            gpios = <&gpio2 2 1>;      /* GPIO2_2 = P8.7, active-low (1) */
            debounce-interval = <20>;  /* 20ms hardware debounce */
        };

        button@1 {
            label = "BTN_2";
            linux,code = <257>;        /* BTN_1 */
            gpios = <&gpio2 3 1>;      /* GPIO2_3 = P8.8, active-low */
            debounce-interval = <20>;
        };

        button@2 {
            label = "BTN_3";
            linux,code = <258>;        /* BTN_2 */
            gpios = <&gpio2 5 1>;      /* GPIO2_5 = P8.9, active-low */
            debounce-interval = <20>;
        };

        button@3 {
            label = "BTN_4";
            linux,code = <259>;        /* BTN_3 */
            gpios = <&gpio2 4 1>;      /* GPIO2_4 = P8.10, active-low */
            debounce-interval = <20>;
        };
    };
};
