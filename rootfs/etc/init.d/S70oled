# /etc/init.d/S70oled: load the SSD1315 OLED and MPU6050 IMU drivers.
# gpio-keys is built into the kernel, the buttons need no module.

MODULES="ssd1315_oled inv_mpu6050_i2c"

is_loaded() { [ -d "/sys/module/$1" ]; }

case "$1" in
start)
    for m in $MODULES; do
        if modprobe "$m"; then
            echo "S70oled: $m loaded"
        else
            echo "S70oled: failed to load $m" >&2
        fi
    done
    [ -c /dev/ssd1315 ] || echo "S70oled: /dev/ssd1315 missing, check 'dmesg | grep ssd1315'" >&2
    ;;
stop)
    for m in inv_mpu6050_i2c ssd1315_oled; do
        is_loaded "$m" && modprobe -r "$m"
    done
    ;;
restart)
    "$0" stop
    "$0" start
    ;;
status)
    rc=0
    for m in $MODULES; do
        if is_loaded "$m"; then echo "$m loaded"; else echo "$m NOT loaded"; rc=1; fi
    done
    exit $rc
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
exit 0
